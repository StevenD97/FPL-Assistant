.claude/settings.local.json
backend/.env
# Both spellings: `python -m venv .venv` is the common one and was missing,
# so a whole interpreter's worth of site-packages was one `git add -A` away
# from the history.
backend/venv/
backend/.venv/
venv/
.venv/
# FPL data snapshots live in a sibling data/ folder at the repo root. The
# archived training files plus a pinned live snapshot (bootstrap_static.json /
# fixtures.json) are tracked so the deterministic golden tests reproduce for
# everyone - ensure_data_fetched only fetches when these are missing, so the
# committed copies win. Generated CSVs stay ignored.
data/*
!data/bootstrap_static_2025_26_final.json
!data/fixtures_2025_26_final.json
!data/gw_history_2025_26.csv
!data/bootstrap_static.json
!data/fixtures.json
__pycache__/
*.pyc

frontend/node_modules/
frontend/.next/
