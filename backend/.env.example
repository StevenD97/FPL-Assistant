API_FOOTBALL_KEY=your_key_here

# --- Database ---
# Postgres connection. Local dev default matches docker-compose.yml (run it
# with `podman compose up -d`). In production set this to the RDS endpoint;
# no code changes needed. If unset, the app falls back to reading the on-disk
# JSON/CSV snapshots in backend/data/.
DATABASE_URL=postgresql+psycopg://fpl:fpl_local_dev@localhost:5432/fpl

# Seasons: the model trains on ARCHIVE_SEASON; the live roster/predictions
# target CURRENT_SEASON (see README's live/archived split).
ARCHIVE_SEASON=2025_26
CURRENT_SEASON=2026_27

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default (used automatically if this isn't set):
# http://localhost:3000,http://192.168.0.19:3000
# In production, set this to your deployed frontend's URL, e.g.:
# ALLOWED_ORIGINS=https://fpl-assistant.vercel.app
